#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
WORKFLOW_DIR="$ROOT_DIR/.github/workflows"
RELEASE_WORKFLOW="$WORKFLOW_DIR/release.yml"
readonly FENCE_REF="openai/fence@e6b39c80c51cb2b2a39448ddeff74b3b886c0a63"

fail() {
  echo "GitHub Actions policy: $1" >&2
  exit 1
}

extract_action_uses() {
  local line="${1%%#*}"
  local key="${line%%:*}"
  local value="${line#*:}"

  key=$(printf '%s' "$key" | tr -d "[:space:]\"'")
  key="${key#-}"
  [[ "$key" == "uses" ]] || return 1

  value=$(sed -E 's/^[[:space:]]*//; s/[[:space:]]*$//' <<< "$value")
  [[ -n "$value" ]] || return 1
  printf '%s\n' "$value"
}

validate_workflow_steps() {
  awk -v fence_ref="$FENCE_REF" '
    function trim(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return value
    }

    function scalar(value, quote) {
      value = trim(value)
      quote = substr(value, 1, 1)
      if ((quote == "\"" || quote == "\047") && substr(value, length(value), 1) == quote) {
        value = substr(value, 2, length(value) - 2)
      }
      return value
    }

    function report(message) {
      printf "%s:%d: %s\n", FILENAME, step_line, message > "/dev/stderr"
      invalid = 1
    }

    function expected_release_allowlist(job) {
      if (job == "attest") {
        return "fulcio.sigstore.dev\nrekor.sigstore.dev"
      }
      if (job == "verify") {
        return "tuf-repo-cdn.sigstore.dev\ntuf-repo.github.com"
      }
      if (job == "release") {
        return "uploads.github.com"
      }
      if (job == "release_info") {
        return ""
      }
      return "__unexpected_release_job__"
    }

    function finish_step() {
      if (!have_step) {
        return
      }

      if (checkout) {
        if (persist_credentials != "false") {
          report("actions/checkout must set persist-credentials: false in the same step")
        }
        if (FILENAME ~ /\/release[.]yml$/) {
          if (checkout_ref != "${{ github.sha }}") {
            report("release checkout must use the event commit")
          }
          if (fetch_depth != "1") {
            report("release checkout must use fetch-depth: 1")
          }
        }
      }

      if (fence) {
        if (step_name != "fence") {
          report("Fence step must be named fence")
        }
        if (action_ref != fence_ref || !fence_pin_comment) {
          report("Fence must use the v0.10.0 release distribution commit")
        }
        if (step_number != 1) {
          report("Fence must be the first meaningful step")
        }
        if (mode != "") {
          report("Fence must use default block mode without a mode override")
        }
        if (FILENAME ~ /\/release[.]yml$/) {
          if (allow_github_artifacts != "true") {
            report("release Fence jobs must enable bounded GitHub artifact access")
          }
          expected_allowlist = expected_release_allowlist(job_id)
          if (expected_allowlist == "__unexpected_release_job__") {
            report("Fence is not expected in this release job")
          } else if (allowlist != expected_allowlist) {
            report("release Fence job has an unexpected allowlist")
          }
        }
      }
    }

    function finish_steps() {
      finish_step()
      in_steps = 0
      have_step = 0
    }

    FNR == 1 {
      finish_steps()
      job_id = ""
    }

    {
      raw = $0
      line = raw
      sub(/[[:space:]]*#.*/, "", line)
      if (line ~ /^[[:space:]]*$/) {
        next
      }

      indent = match(line, /[^[:space:]]/) - 1
      content = substr(line, indent + 1)
      if (in_steps && indent <= steps_indent) {
        finish_steps()
      }

      if (indent == 2 && content ~ /^[A-Za-z0-9_-]+:[[:space:]]*$/) {
        job_id = content
        sub(/:.*/, "", job_id)
      }

      if (line ~ /^[[:space:]]*steps:[[:space:]]*$/) {
        in_steps = 1
        steps_indent = indent
        step_number = 0
        next
      }

      if (!in_steps) {
        next
      }

      key_indent = indent
      if (indent == steps_indent + 2 && content ~ /^-[[:space:]]+/) {
        finish_step()
        have_step = 1
        step_number++
        step_line = FNR
        step_indent = indent
        step_name = ""
        action_ref = ""
        checkout = 0
        fence = 0
        fence_pin_comment = 0
        with_indent = -1
        persist_credentials = ""
        checkout_ref = ""
        fetch_depth = ""
        mode = ""
        allow_github_artifacts = ""
        allowlist = ""
        allowlist_indent = -1
        sub(/^-[[:space:]]+/, "", content)
        key_indent = indent + 2
      } else if (!have_step) {
        next
      }

      if (allowlist_indent >= 0 && indent > allowlist_indent) {
        allowlist_item = trim(content)
        if (allowlist != "") {
          allowlist = allowlist "\n"
        }
        allowlist = allowlist allowlist_item
        next
      }

      delimiter = index(content, ":")
      if (!delimiter) {
        next
      }

      key = substr(content, 1, delimiter - 1)
      key = trim(key)
      gsub(/^["\047]|["\047]$/, "", key)
      value = scalar(substr(content, delimiter + 1))

      if (key_indent == step_indent + 2) {
        if (key == "name") {
          step_name = value
        } else if (key == "uses") {
          action_ref = value
          checkout = action_ref ~ /^actions\/checkout@/
          fence = action_ref ~ /^openai\/fence@/
          fence_pin_comment = raw ~ /#[[:space:]]*pin@v0[.]10[.]0[[:space:]]*$/
        } else if (key == "with") {
          with_indent = key_indent
        }
      } else if (with_indent >= 0 && key_indent == with_indent + 2) {
        if (key == "persist-credentials") {
          persist_credentials = value
        } else if (key == "ref") {
          checkout_ref = value
        } else if (key == "fetch-depth") {
          fetch_depth = value
        } else if (key == "mode") {
          mode = value
        } else if (key == "allow_github_artifacts") {
          allow_github_artifacts = value
        } else if (key == "allowlist") {
          if (value != "|") {
            report("Fence allowlist must use a multiline block")
          }
          allowlist_indent = key_indent
        }
      }
    }

    END {
      finish_steps()
      exit invalid
    }
  ' "$@"
}

readonly ACTION_FIXTURE="example/action@0123456789abcdef0123456789abcdef01234567"
for action_line in \
  "  - uses: $ACTION_FIXTURE # ignored uses: attacker/action@main" \
  "  \"uses\": $ACTION_FIXTURE # ignored" \
  "  - 'uses': $ACTION_FIXTURE # ignored"; do
  [[ "$(extract_action_uses "$action_line")" == "$ACTION_FIXTURE" ]] || fail "action parser regression"
done
if extract_action_uses "  name: checkout # uses: attacker/action@main" >/dev/null; then
  fail "action parser accepted a non-uses key"
fi

if validate_workflow_steps <(printf '%s\n' \
  "jobs:" \
  "  test:" \
  "    steps:" \
  "      - \"uses\": actions/checkout@0123456789abcdef0123456789abcdef01234567" \
  "      - uses: actions/checkout@0123456789abcdef0123456789abcdef01234567" \
  "        with:" \
  "          persist-credentials: false") 2>/dev/null; then
  fail "step policy accepted an unsafe checkout followed by a safe checkout"
fi

if validate_workflow_steps <(printf '%s\n' \
  "jobs:" \
  "  test:" \
  "    steps:" \
  "      - name: fence" \
  "        uses: $FENCE_REF # pin@v0.10.0" \
  "        with:" \
  "          mode: audit") 2>/dev/null; then
  fail "step policy accepted Fence audit mode"
fi

if grep -R -n -E '^[[:space:]]*pull_request_target:' "$WORKFLOW_DIR" >/dev/null; then
  fail "pull_request_target is prohibited"
fi

if grep -R -n -E 'uses:[[:space:]]*actions/cache@' "$WORKFLOW_DIR" >/dev/null; then
  fail "the shared Actions cache is prohibited"
fi

while IFS= read -r cache_line; do
  value="${cache_line#*:}"
  value="${value%%#*}"
  value=$(printf '%s' "$value" | tr -d "[:space:]\"'")
  if [[ "$value" != "false" ]]; then
    fail "setup-action caches must be explicitly disabled: $cache_line"
  fi
done < <(grep -R -h -E '^[[:space:]]+(bundler-)?cache:' "$WORKFLOW_DIR" || true)

while IFS= read -r uses_line; do
  uses=$(extract_action_uses "$uses_line") || fail "unable to parse action reference: $uses_line"
  [[ "$uses" == ./* ]] && continue

  action="${uses%%@*}"
  case "$action" in
    actions/checkout|actions/upload-artifact|actions/download-artifact|actions/attest|openai/fence) ;;
    *) fail "action is not allowlisted: $action" ;;
  esac

  if [[ ! "$uses" =~ @[0-9a-fA-F]{40}$ ]] && [[ ! "$uses" =~ @sha256:[0-9a-fA-F]{64}$ ]]; then
    fail "action is not pinned to an immutable digest: $uses"
  fi
done < <(grep -R -h -E "^[[:space:]]*(-[[:space:]]+)?(uses|\"uses\"|'uses')[[:space:]]*:" "$WORKFLOW_DIR")

while IFS= read -r workflow; do
  validate_workflow_steps "$workflow" || fail "workflow step policy failed"
done < <(find "$WORKFLOW_DIR" -type f \( -name "*.yml" -o -name "*.yaml" \) -print)

[[ "$(grep -c "uses: $FENCE_REF" "$RELEASE_WORKFLOW")" == "4" ]] || fail "release workflow must protect all four Linux jobs with Fence"
[[ "$(grep -c 'allow_github_artifacts: true' "$RELEASE_WORKFLOW")" == "4" ]] || fail "release Fence jobs must enable bounded GitHub artifact access"
if grep -q -E '^[[:space:]]+mode:' "$RELEASE_WORKFLOW"; then
  fail "release Fence jobs must use default block mode"
fi

grep -q "branches:" "$RELEASE_WORKFLOW" || fail "release workflow must restrict its branch"
grep -q -- "- main" "$RELEASE_WORKFLOW" || fail "release workflow must target main"
if grep -q "workflow_dispatch:" "$RELEASE_WORKFLOW"; then
  fail "release workflow must not have a manual dispatch path"
fi
grep -Fq 'github.workflow_sha == github.sha' "$RELEASE_WORKFLOW" || fail "release workflow must come from the event commit"
grep -Fq 'actual_sha=$(git rev-parse HEAD)' "$RELEASE_WORKFLOW" || fail "release checkout must verify HEAD"
grep -Fq "if: \${{ always() && needs.build.result == 'success' && needs.release.result == 'success' }}" "$RELEASE_WORKFLOW" || fail "release info must require successful publication"

finalize_job=$(awk '
  /^  finalize:$/ { in_job = 1 }
  in_job && /^  [A-Za-z0-9_-]+:$/ && $0 != "  finalize:" { exit }
  in_job { print }
' "$RELEASE_WORKFLOW")
[[ -n "$finalize_job" ]] || fail "release workflow must have a finalize job"
grep -Fq '    environment: release' <<< "$finalize_job" || fail "finalize job must use the protected release environment"
grep -Fq '    runs-on: macos-26' <<< "$finalize_job" || fail "finalize job must use the pinned macOS runner label"
grep -Fq '    permissions: {}' <<< "$finalize_job" || fail "finalize job must not receive a GitHub token"
if grep -q 'actions/checkout@' <<< "$finalize_job"; then
  fail "finalize job must not check out repository code"
fi
if grep -q -E 'run:[[:space:]]+script/|^[[:space:]]+script/' <<< "$finalize_job"; then
  fail "finalize job must not execute repository scripts"
fi
[[ "$(grep -Fc 'artifact-ids: ${{ needs.build.outputs.artifact-id }}' "$RELEASE_WORKFLOW")" == "1" ]] || fail "only finalize may download the unnotarized build artifact"
[[ "$(grep -Fc 'artifact-ids: ${{ needs.finalize.outputs.artifact-id }}' "$RELEASE_WORKFLOW")" == "4" ]] || fail "all downstream jobs must download the finalized artifact by ID"
grep -Fq 'artifact-id: ${{ steps.upload-artifact.outputs.artifact-id }}' <<< "$finalize_job" || fail "finalize job must export its artifact ID"

verify_line=$(grep -nF '      - name: verify unnotarized artifact' "$RELEASE_WORKFLOW" | cut -d: -f1)
signing_line=$(grep -nF '      - name: sign and notarize release artifact' "$RELEASE_WORKFLOW" | cut -d: -f1)
if [[ -z "$verify_line" || -z "$signing_line" || "$verify_line" -ge "$signing_line" ]]; then
  fail "finalize must validate the unnotarized artifact before exposing signing credentials"
fi

signing_step=$(awk '
  /^      - name: sign and notarize release artifact$/ { in_step = 1 }
  in_step && /^      - name:/ && $0 != "      - name: sign and notarize release artifact" { exit }
  in_step { print }
' "$RELEASE_WORKFLOW")
[[ -n "$signing_step" ]] || fail "release workflow must have a signing and notarization step"

for secret in \
  APPLE_DEVELOPER_ID_P12_BASE64 \
  APPLE_DEVELOPER_ID_P12_PASSWORD \
  APPLE_NOTARY_KEY_P8_BASE64 \
  APPLE_NOTARY_KEY_ID \
  APPLE_NOTARY_ISSUER_ID; do
  reference="${secret}: \${{ secrets.${secret} }}"
  [[ "$(grep -Fc "$reference" "$RELEASE_WORKFLOW")" == "1" ]] || fail "$secret must be referenced exactly once"
  grep -Fq "$reference" <<< "$signing_step" || fail "$secret must be scoped to the signing step"
done

team_reference='APPLE_TEAM_ID: ${{ vars.APPLE_TEAM_ID }}'
[[ "$(grep -Fc "$team_reference" "$RELEASE_WORKFLOW")" == "1" ]] || fail "APPLE_TEAM_ID must be referenced exactly once"
grep -Fq "$team_reference" <<< "$signing_step" || fail "APPLE_TEAM_ID must be scoped to the signing step"

for command in \
  'trap cleanup EXIT' \
  'security create-keychain' \
  'security import "$certificate_path"' \
  'security set-key-partition-list' \
  'security find-identity' \
  'Developer ID Application:' \
  '--options runtime' \
  '--timestamp' \
  '--keychain "$keychain_path"' \
  'TeamIdentifier=$APPLE_TEAM_ID' \
  'xcrun notarytool submit' \
  '--wait' \
  'xcrun notarytool log' \
  '"$notarization_status" != "Accepted"' \
  'xcrun stapler staple' \
  'xcrun stapler validate' \
  'spctl --assess --type execute'; do
  grep -Fq -- "$command" <<< "$signing_step" || fail "signing step must include: $command"
done

[[ "$(grep -c 'id-token: write' "$RELEASE_WORKFLOW")" == "1" ]] || fail "OIDC permission must exist in exactly one isolated job"
[[ "$(grep -c 'attestations: write' "$RELEASE_WORKFLOW")" == "1" ]] || fail "attestation permission must exist in exactly one isolated job"
[[ "$(grep -c 'artifact-metadata: write' "$RELEASE_WORKFLOW")" == "1" ]] || fail "artifact metadata permission must exist in exactly one isolated job"
[[ "$(grep -c 'contents: write' "$RELEASE_WORKFLOW")" == "1" ]] || fail "contents write permission must exist in exactly one publication job"
[[ "$(grep -c 'environment: release' "$RELEASE_WORKFLOW")" -ge 2 ]] || fail "attestation and publication must use the protected release environment"
grep -q -- "--source-digest" "$RELEASE_WORKFLOW" || fail "attestation verification must bind the source commit"
grep -q -- "--signer-digest" "$RELEASE_WORKFLOW" || fail "attestation verification must bind the signer workflow commit"
grep -Fq 'bundle_artifact_id: ${{ steps.upload_bundle.outputs.artifact-id }}' "$RELEASE_WORKFLOW" || fail "attestation bundle artifact ID must be passed to verification"
grep -Fq 'path: ${{ steps.attest.outputs.bundle-path }}' "$RELEASE_WORKFLOW" || fail "the exact generated attestation bundle must be uploaded"
grep -Fq 'artifact-ids: ${{ needs.attest.outputs.bundle_artifact_id }}' "$RELEASE_WORKFLOW" || fail "verification must download the generated attestation bundle"
grep -q -- '--bundle "$bundle_path"' "$RELEASE_WORKFLOW" || fail "verification must use the downloaded attestation bundle"

echo "GitHub Actions policy: OK"
