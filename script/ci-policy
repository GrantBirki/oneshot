#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
WORKFLOW_DIR="$ROOT_DIR/.github/workflows"
RELEASE_WORKFLOW="$WORKFLOW_DIR/release.yml"
PROJECT_CONFIG="$ROOT_DIR/project.yml"
VERIFY_PACKAGE_SCRIPT="$ROOT_DIR/script/verify-package"
FENCE_SHA="e6b39c80c51cb2b2a39448ddeff74b3b886c0a63"
USES_PATTERN='^([[:space:]]{4}|[[:space:]]{8}|[[:space:]]{6}-[[:space:]]+)uses[[:space:]]*:'

fail() {
  echo "GitHub Actions policy: $1" >&2
  exit 1
}

require() {
  grep -Fq -- "$1" <<< "$2" || fail "$3"
}

forbid() {
  if grep -Fq -- "$1" <<< "$2"; then
    fail "$3"
  fi
}

job_block() {
  local header="  $1:"
  awk -v header="$header" '
    $0 == header { found = 1 }
    found && /^  [A-Za-z0-9_-]+:$/ && $0 != header { exit }
    found { print }
    END { if (!found) exit 1 }
  ' "$RELEASE_WORKFLOW"
}

step_block() {
  local header="      - name: $1"
  awk -v header="$header" '
    $0 == header { found = 1 }
    found && /^      - name:/ && $0 != header { exit }
    found { print }
    END { if (!found) exit 1 }
  ' <<< "$2"
}

check_fence() {
  local job="$1"
  local expected_allowlist="$2"
  local block first_step allowlist
  block=$(job_block "$job") || fail "release workflow is missing the $job job"
  first_step=$(grep -m1 -E '^      - name:' <<< "$block")
  [[ "$first_step" == "      - name: fence" ]] || fail "Fence must be the first step in $job"
  require "uses: openai/fence@$FENCE_SHA" "$block" "Fence must use the reviewed pin in $job"
  require "allow_github_artifacts: true" "$block" "Fence must allow GitHub artifact access in $job"
  forbid "          mode:" "$block" "Fence must run in enforcement mode in $job"
  allowlist=$(awk '
    $0 == "          allowlist: |" { capture = 1; next }
    capture && /^            [^[:space:]]/ { print substr($0, 13); next }
    capture { exit }
  ' <<< "$block")
  [[ "$allowlist" == "$expected_allowlist" ]] || fail "Fence allowlist changed in $job"
}

workflow_text=$(find "$WORKFLOW_DIR" -type f \( -name '*.yml' -o -name '*.yaml' \) -exec sed -n '1,$p' {} +)
release_text=$(<"$RELEASE_WORKFLOW")
project_text=$(<"$PROJECT_CONFIG")
verify_package_text=$(<"$VERIFY_PACKAGE_SCRIPT")

forbid "pull_request_target:" "$workflow_text" "pull_request_target is prohibited"
if grep -R -n -E "^[[:space:]]*(-[[:space:]]+)?[\"']uses[\"'][[:space:]]*:" "$WORKFLOW_DIR" >/dev/null; then
  fail "uses keys must use the repository's canonical unquoted form"
fi

checkout_count=0
while IFS= read -r line; do
  use="${line#*:}"
  use="${use%%#*}"
  use=$(printf '%s' "$use" | tr -d "[:space:]\"'")
  [[ -n "$use" ]] || fail "empty action reference"
  [[ "$use" == ./* ]] && continue

  action="${use%%@*}"
  case "$action" in
    actions/checkout|actions/upload-artifact|actions/download-artifact|actions/attest|openai/fence) ;;
    *) fail "action is not allowlisted: $action" ;;
  esac
  if [[ ! "$use" =~ @[0-9a-f]{40}$ ]] && [[ ! "$use" =~ @sha256:[0-9a-f]{64}$ ]]; then
    fail "action is not pinned to an immutable digest: $use"
  fi
  [[ "$action" == "actions/checkout" ]] && checkout_count=$((checkout_count + 1))
done < <(grep -R -h -E "$USES_PATTERN" "$WORKFLOW_DIR")

persist_count=$({ grep -R -h -E '^[[:space:]]+persist-credentials:[[:space:]]+false([[:space:]]|$)' "$WORKFLOW_DIR" || true; } | wc -l | tr -d ' ')
[[ "$persist_count" == "$checkout_count" ]] || fail "every checkout must disable persisted credentials"

require "      - main" "$release_text" "release workflow must target main"
require '      - "VERSION"' "$release_text" "release workflow must trigger only when VERSION changes"
require "github.event_name == 'push'" "$release_text" "release workflow must require a push"
require "github.ref == 'refs/heads/main'" "$release_text" "release workflow must require main"
require "github.workflow_sha == github.sha" "$release_text" "release workflow must use its own trusted definition"
forbid "workflow_dispatch:" "$release_text" "release workflow must not support manual dispatch"
[[ "$(grep -c 'actions/checkout@' "$RELEASE_WORKFLOW")" == "1" ]] || fail "release workflow must have exactly one checkout"
require 'ref: ${{ github.sha }}' "$release_text" "release checkout must use the event commit"
require "fetch-depth: 1" "$release_text" "release checkout must be shallow"

require "ENABLE_HARDENED_RUNTIME: YES" "$project_text" "hardened runtime must be explicit"
require "ARCHS: arm64" "$project_text" "release builds must target arm64"
forbid "x86_64" "$project_text$verify_package_text$release_text" "release paths must not target x86_64"
require "lipo -archs" "$verify_package_text" "package verification must check architecture"
require "codesign -d --entitlements" "$verify_package_text" "package verification must check entitlements"

sign_job=$(job_block sign) || fail "release workflow is missing the sign job"
attest_job=$(job_block attest) || fail "release workflow is missing the attest job"
verify_job=$(job_block verify) || fail "release workflow is missing the verify job"
release_job=$(job_block release) || fail "release workflow is missing the publication job"
signing_step=$(step_block "sign + notarize" "$sign_job") || fail "sign job is missing the signing step"

require "    needs: build" "$sign_job" "sign must depend on build"
require "    environment: release" "$sign_job" "sign must use the release environment"
require "    permissions: {}" "$sign_job" "sign must not receive a GitHub token"
require "    needs: [build, sign]" "$attest_job" "attest must depend on build and sign"
require "    needs: [build, sign, attest]" "$verify_job" "verify must depend on all prior jobs"
require "    needs: [build, sign, verify]" "$release_job" "release must depend on build, sign, and verify"
forbid "actions/checkout@" "$sign_job" "sign must not check out repository code"
forbid "run: script/" "$sign_job" "sign must not execute repository scripts"

verify_line=$(grep -nF '      - name: verify unnotarized artifact' "$RELEASE_WORKFLOW" | cut -d: -f1)
signing_line=$(grep -nF '      - name: sign + notarize' "$RELEASE_WORKFLOW" | cut -d: -f1)
[[ "$verify_line" -lt "$signing_line" ]] || fail "artifact verification must precede secret exposure"

for control in \
  "lipo -archs" \
  "codesign -d --entitlements" \
  "trap cleanup EXIT" \
  "security create-keychain" \
  "codesign \\" \
  "xcrun notarytool submit" \
  "xcrun stapler validate" \
  "spctl --assess --type execute"; do
  require "$control" "$sign_job" "sign job is missing: $control"
done

calendar_entitlement="com.apple.security.personal-information.calendars"
if grep -Fq "$calendar_entitlement" "$PROJECT_CONFIG"; then
  require "$calendar_entitlement" "$verify_package_text" "package verification must require Calendar access"
  require "$calendar_entitlement" "$sign_job" "sign must preserve Calendar access"
else
  forbid '--entitlements "$entitlements_path"' "$signing_step" "an entitlement-free app must not sign with an entitlement file"
fi

for reference in \
  'APPLE_DEVELOPER_ID_P12_BASE64: ${{ secrets.APPLE_DEVELOPER_ID_P12_BASE64 }}' \
  'APPLE_DEVELOPER_ID_P12_PASSWORD: ${{ secrets.APPLE_DEVELOPER_ID_P12_PASSWORD }}' \
  'APPLE_NOTARY_KEY_P8_BASE64: ${{ secrets.APPLE_NOTARY_KEY_P8_BASE64 }}' \
  'APPLE_NOTARY_KEY_ID: ${{ secrets.APPLE_NOTARY_KEY_ID }}' \
  'APPLE_NOTARY_ISSUER_ID: ${{ secrets.APPLE_NOTARY_ISSUER_ID }}' \
  'APPLE_TEAM_ID: ${{ vars.APPLE_TEAM_ID }}'; do
  [[ "$(grep -Fc "$reference" "$RELEASE_WORKFLOW" || true)" == "1" ]] || fail "$reference must appear exactly once"
  require "$reference" "$signing_step" "$reference must be scoped to the signing step"
done

[[ "$(grep -c 'id-token: write' "$RELEASE_WORKFLOW")" == "1" ]] || fail "OIDC write permission must be isolated"
[[ "$(grep -c 'attestations: write' "$RELEASE_WORKFLOW")" == "1" ]] || fail "attestation write permission must be isolated"
[[ "$(grep -c 'artifact-metadata: write' "$RELEASE_WORKFLOW")" == "1" ]] || fail "artifact metadata permission must be isolated"
[[ "$(grep -c 'contents: write' "$RELEASE_WORKFLOW")" == "1" ]] || fail "contents write permission must be isolated"
[[ "$(grep -c 'environment: release' "$RELEASE_WORKFLOW")" == "1" ]] || fail "only sign may use the release environment"
[[ "$(grep -c 'environment: publish' "$RELEASE_WORKFLOW")" == "2" ]] || fail "only attest and release may use the publish environment"

require "gh attestation verify" "$verify_job" "verify job must validate provenance"
for flag in "--bundle" "--source-digest" "--signer-digest" "--deny-self-hosted-runners"; do
  require "$flag" "$verify_job" "attestation verification is missing $flag"
done

check_fence attest $'fulcio.sigstore.dev\nrekor.sigstore.dev'
check_fence verify $'tuf-repo-cdn.sigstore.dev\ntuf-repo.github.com'
check_fence release 'uploads.github.com'
[[ "$(grep -c 'openai/fence@' "$RELEASE_WORKFLOW")" == "3" ]] || fail "Fence must protect attest, verify, and release"

echo "GitHub Actions policy: OK"
